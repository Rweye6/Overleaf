% --- Définition des environnements personnalisés ---

\newmdenv[
linewidth=1pt,
roundcorner=20pt,
skipabove=10pt,
skipbelow=10pt,
innerleftmargin=8pt,
innerrightmargin=8pt,
innertopmargin=8pt,
innerbottommargin=8pt
]{basebox}

\newenvironment{cours}[1][Cours]{%
	\begin{basebox}[
		backgroundcolor=blue!5,
		linecolor=blue!5,
		frametitle={\color{blue!75!black}\bfseries #1}
		]
	}{\end{basebox}}

\newenvironment{definition}[1][Définition]{%
	\begin{basebox}[
		backgroundcolor=green!5,
		linecolor=green!5,
		frametitle={\color{green!75!black}\bfseries #1}
		]
	}{\end{basebox}}

\newenvironment{exemple}[1][Exemples]{%
	\begin{basebox}[
		backgroundcolor=orange!5,
		linecolor=orange!5,
		frametitle={\color{orange!75!black}\bfseries #1}
		]
	}{\end{basebox}}

